### 인덱스 생성
PUT blog-posts
{
  "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
  "mappings": {
    "properties": {
      "title": { "type": "text" },
      "content": { "type": "text" },
      "author": { "type": "keyword" },
      "tags": { "type": "keyword" },
      "created_at": { "type": "date" },
      "views": { "type": "integer" }
    }
  }
}


### Bulk API
# 여러 작업을 한 번에 처리하는 방법
# 액션 메타데이터 한 줄과 실제 문서 한 줄이 한 쌍
POST _bulk
{ "index": { "_index": "blog-posts", "_id": 1 } }
{ "title": "제주도 한 달 살기 비용 공개", "content": "제주 한 달 살기 실제 비용 및 팁", "author": "Hana", "tags": ["여행", "제주", "라이프스타일"], "created_at": "2026-06-11", "views": 489 }
